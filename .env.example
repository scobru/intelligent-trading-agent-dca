# ==============================================================================
# INTELLIGENT TRADING AGENT - DCA & PORTFOLIO REBALANCER (BASE L2)
# ==============================================================================

# Rete Base (Chain ID 8453)
BASE_RPC_URL=https://mainnet.base.org
WALLET_ADDRESS=
PRIVATE_KEY=

# Modalita' operativa (DRY_RUN=true non firma transazioni on-chain)
DRY_RUN=true
PAPER_TRADING=true
PAPER_START_USDC=1000.0
PAPER_START_ETH=0.05
PAPER_GAS_USD=0.02

# Allocazione di Portafoglio Obiettivo (Base Diversified Index)
# Formato: SIMBOLO:PESO,SIMBOLO:PESO (normalizzato automaticamente a 1.0)
TARGET_WEIGHTS=WETH:0.25,CBBTC:0.25,LINK:0.15,UNI:0.10,AERO:0.10,USDC:0.15

# Strategia DCA Dinamica (Fear & Greed)
DCA_ENABLED=true
DCA_BASE_AMOUNT_USD=50.0
DCA_INTERVAL_HOURS=24.0
FEAR_GREED_ENABLED=true

# Moltiplicatori DCA in base all'indice Crypto Fear & Greed (0-100)
# Extreme Fear (<=25): compra 1.5x (compra il dip)
# Fear (26-45): compra 1.25x
# Neutral (46-55): compra 1.0x (standard)
# Greed (56-75): compra 0.75x
# Extreme Greed (>=76): compra 0.50x (accumulo cauto)
MULTIPLIER_EXTREME_FEAR=1.50
MULTIPLIER_FEAR=1.25
MULTIPLIER_NEUTRAL=1.00
MULTIPLIER_GREED=0.75
MULTIPLIER_EXTREME_GREED=0.50

# Strategia di Ribilanciamento Automatico
REBALANCE_ENABLED=true
REBALANCE_THRESHOLD_PCT=5.0
MIN_REBALANCE_USD=10.0
MAX_REBALANCE_USD=1500.0
MIN_HOLD_HOURS_BETWEEN_REBALANCE=12.0

# Parametri di Esecuzione & Slippage Uniswap V3
DEFAULT_SLIPPAGE_BPS=50
MAX_SLIPPAGE_BPS=100
MAX_GAS_PRICE_GWEI=0.5
MIN_ETH_RESERVE=0.001

# Auto-refuel USDC da ETH
AUTO_SWAP_ETH_TO_USDC=true
ETH_GAS_RESERVE=0.003
MIN_ETH_SWAP_AMOUNT=0.002
USDC_AUTO_SWAP_THRESHOLD=5.0

# AI Reasoning (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
LLM_FALLBACK_RULES=true

# Notifiche e Comandi Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard Web
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_ADMIN_TOKEN=

# Ciclo di loop (secondi fra controlli orari/regolari)
LOOP_SLEEP_SECONDS=1800
